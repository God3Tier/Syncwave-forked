# Optional secrets for local development.
#
#   cp .env.example .env      # .env is gitignored
#
# `docker compose up` works WITHOUT this file: every local credential
# (RabbitMQ, Postgres, S3) is a fixed development value in docker-compose.yml.
# Only real third-party secrets belong here. Services load this file through
# the `env_file:` entry in their compose fragment.

# Recommendation Service - weather context (external API).
# Leave empty to exercise the "no weather" fallback.
WEATHER_API_KEY=
