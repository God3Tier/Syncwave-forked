{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncwave.local/contracts/websocket/error.schema.json",
  "title": "ERROR",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "jam_id", "seq", "sent_at_ms", "payload"],
  "properties": {
    "type": { "const": "ERROR" },
    "jam_id": { "type": "string", "format": "uuid" },
    "seq": { "type": "integer", "minimum": 0 },
    "sent_at_ms": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_MESSAGE",
            "UNAUTHORIZED",
            "UNKNOWN_JAM",
            "INVALID_STATE",
            "STALE_GENERATION",
            "STALE_SEQUENCE",
            "SONG_NOT_READY",
            "STREAM_UNAVAILABLE",
            "PREPARE_TIMEOUT",
            "DEPENDENCY_UNAVAILABLE"
          ]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
