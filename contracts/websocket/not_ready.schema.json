{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncwave.local/contracts/websocket/not_ready.schema.json",
  "title": "NOT_READY",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "jam_id", "seq", "sent_at_ms", "payload"],
  "properties": {
    "type": { "const": "NOT_READY" },
    "jam_id": { "type": "string", "format": "uuid" },
    "seq": { "type": "integer", "minimum": 0 },
    "sent_at_ms": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "reason"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1 },
        "reason": { "enum": ["AUDIO_LOCKED", "AUDIO_SUSPENDED", "AUDIO_ERROR", "BUFFER_LOST"] }
      }
    }
  }
}
