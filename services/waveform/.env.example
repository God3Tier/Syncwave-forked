# Settings this service reads, with local example values. Running in Compose,
# the values come from compose.yaml; this file documents them for running the
# API or worker directly on your machine against the Compose infrastructure.
SERVICE_NAME=waveform
PORT=8080
LOG_LEVEL=INFO
AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=syncwave
AMQP_PASSWORD=syncwave
# Unacknowledged messages one worker processes at a time (decoding is CPU-heavy)
AMQP_PREFETCH=2
DB_HOST=localhost
DB_PORT=5432
DB_NAME=waveform
DB_USER=waveform
DB_PASSWORD=waveform
# Optional: overrides the DB_* variables (the tests use SQLite this way)
# DATABASE_URL=sqlite+aiosqlite:///waveform.db
S3_ENDPOINT_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=syncwave
AWS_SECRET_ACCESS_KEY=syncwave-secret
AWS_REGION=us-east-1
S3_BUCKET=syncwave-audio
# Peaks stored per song (the API can return fewer with ?points=)
WAVEFORM_POINTS=1000
# Rate the audio is decoded at; the visualiser bands reach half of it (11 kHz)
WAVEFORM_SAMPLE_RATE=22050
# Visualiser: band levels per second, and frequency bands per frame
WAVEFORM_FRAME_RATE=25
WAVEFORM_BANDS=50
# Larger audio files are rejected (AUDIO_TOO_LARGE); 200 MB = the gateway's upload limit
WAVEFORM_MAX_AUDIO_BYTES=209715200
# Longer decodes are retried, then fail (DECODE_TIMEOUT)
WAVEFORM_DECODE_TIMEOUT_S=120
