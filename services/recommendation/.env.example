# Settings this service reads, with local example values. Running in Compose,
# the values come from compose.yaml; this file documents them for running the
# API directly on your machine.
SERVICE_NAME=recommendation
PORT=8080
LOG_LEVEL=INFO

# Where candidate songs come from. `http` (default) calls the Catalogue Service
# at CATALOGUE_URL (GET /songs, see README.md); `stub` serves a fixed demo list.
CATALOGUE_MODE=http
CATALOGUE_URL=http://localhost:8080/api/catalogue
CATALOGUE_TIMEOUT_SECONDS=3
# Songs asked of the Catalogue before ranking
CANDIDATE_LIMIT=100

# Where the weather comes from. `open-meteo` (default) calls the real Open-Meteo
# API (no key); `stub` returns WEATHER_STUB_CONDITION for every location; `off`
# behaves like a Weather API that is down, which exercises the "no weather" fallback.
WEATHER_MODE=open-meteo
WEATHER_URL=https://api.open-meteo.com/v1/forecast
# CLEAR, CLOUDY, RAIN, STORM, SNOW, FOG or OTHER
WEATHER_STUB_CONDITION=RAIN
# A slower weather lookup is abandoned and the fallback is used
WEATHER_TIMEOUT_SECONDS=2
