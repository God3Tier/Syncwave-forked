# Settings this service reads, with local example values. Running in Compose,
# the values come from compose.yaml; this file documents them for running the
# API directly on your machine against the Compose infrastructure.
SERVICE_NAME=playlist
PORT=8080
LOG_LEVEL=INFO
DB_HOST=localhost
DB_PORT=5432
DB_NAME=playlist
DB_USER=playlist
DB_PASSWORD=playlist
# gRPC GetPlaylist for Jam and Sync (0 turns it off). Callers send the token in x-internal-token
GRPC_PORT=50051
INTERNAL_SERVICE_TOKEN=local-playlist-internal-token
# `off` accepts any song id; `http` asks the Catalogue whether an added song exists
CATALOGUE_MODE=off
CATALOGUE_URL=http://localhost:8080/api/catalogue
CATALOGUE_TIMEOUT_SECONDS=3
# Optional: overrides the DB_* variables (the tests use SQLite this way)
# DATABASE_URL=sqlite+aiosqlite:///playlist.db
