# Settings this service reads, with local example values. Running in Compose,
# the values come from compose.yaml; this file documents them for running the
# API or worker directly on your machine against the Compose infrastructure.
SERVICE_NAME=catalogue
PORT=8080
LOG_LEVEL=INFO
AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=syncwave
AMQP_PASSWORD=syncwave
# Unacknowledged messages one worker processes at a time
AMQP_PREFETCH=10
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catalogue
DB_USER=catalogue
DB_PASSWORD=catalogue
# Optional: overrides the DB_* variables (the tests use SQLite this way)
# DATABASE_URL=postgresql+asyncpg://catalogue:catalogue@localhost:5432/catalogue
INTERNAL_SERVICE_TOKEN=local-catalogue-internal-token
GRPC_PORT=50051
