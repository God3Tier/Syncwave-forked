# Compose supplies these development values. Production uses secrets/ECS roles.
SERVICE_NAME=upload
PORT=8080
LOG_LEVEL=INFO
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upload
DB_USER=upload
DB_PASSWORD=upload
AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=syncwave
AMQP_PASSWORD=syncwave
AMQP_VHOST=/
S3_ENDPOINT_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=syncwave
AWS_SECRET_ACCESS_KEY=syncwave-secret
AWS_REGION=us-east-1
S3_BUCKET=syncwave-audio
# Leave room under the gateway's 200 MiB total request limit for metadata/lyrics.
UPLOAD_MAX_AUDIO_BYTES=199229440
UPLOAD_MAX_LYRICS_BYTES=262144
UPLOAD_PUBLISH_POLL_SECONDS=2
