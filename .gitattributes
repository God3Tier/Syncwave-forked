# The team develops on Windows but every container runs Linux.
# CRLF line endings break shell scripts, entrypoints and some config files
# inside containers, so the repository always stores LF.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files (test fixtures, images, build artefacts)
*.mp3  binary
*.wav  binary
*.flac binary
*.ogg  binary
*.m4a  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.jar  binary
