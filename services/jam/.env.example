SERVICE_NAME=jam
PORT=8080
# Either DATABASE_URL, or DB_* (used when DATABASE_URL is unset; in AWS the
# password comes from Secrets Manager as DB_PASSWORD)
DATABASE_URL=postgresql+asyncpg://jam:jam@localhost:5432/jam
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=jam
# DB_USER=jam
# DB_PASSWORD=jam
SYNC_GRPC_TARGET=localhost:50051
INTERNAL_SERVICE_TOKEN=local-jam-to-sync-token
PLAYLIST_GRPC_TARGET=localhost:50051
PLAYLIST_INTERNAL_TOKEN=local-playlist-internal-token
PLAYLIST_TIMEOUT_MS=750
MOCK_JAM_TOKEN=local-jam-member-token
JAM_INACTIVITY_TTL_SECONDS=86400
JAM_EXPIRY_SWEEP_SECONDS=60
SYNC_TIMEOUT_MS=1000
