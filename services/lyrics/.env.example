# Settings this service reads, with local example values. Running in Compose,
# the values come from compose.yaml; this file documents them for running the
# API or worker directly on your machine against the Compose infrastructure.
SERVICE_NAME=lyrics
PORT=8080
LOG_LEVEL=INFO
AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=syncwave
AMQP_PASSWORD=syncwave
# Unacknowledged messages one worker processes at a time
AMQP_PREFETCH=10
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lyrics
DB_USER=lyrics
DB_PASSWORD=lyrics
# Optional: overrides the DB_* variables (the tests use SQLite this way)
# DATABASE_URL=sqlite+aiosqlite:///lyrics.db
S3_ENDPOINT_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=syncwave
AWS_SECRET_ACCESS_KEY=syncwave-secret
AWS_REGION=us-east-1
S3_BUCKET=syncwave-audio
# Larger .lrc files are rejected (LYRICS_TOO_LARGE)
LYRICS_MAX_BYTES=262144
