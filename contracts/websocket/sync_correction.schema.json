{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://syncwave.local/contracts/websocket/sync_correction.schema.json",
  "title": "SYNC_CORRECTION",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "jam_id", "seq", "sent_at_ms", "payload"],
  "properties": {
    "type": { "const": "SYNC_CORRECTION" },
    "jam_id": { "type": "string", "format": "uuid" },
    "seq": { "type": "integer", "minimum": 0 },
    "sent_at_ms": { "type": "integer", "minimum": 0 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "method",
        "drift_ms",
        "target_position_ms",
        "playback_rate",
        "apply_at_server_time_ms",
        "duration_ms"
      ],
      "properties": {
        "generation": { "type": "integer", "minimum": 1 },
        "method": { "enum": ["RATE", "SEEK"] },
        "drift_ms": { "type": "integer" },
        "target_position_ms": { "type": "integer", "minimum": 0 },
        "playback_rate": { "type": "number", "exclusiveMinimum": 0 },
        "apply_at_server_time_ms": { "type": "integer", "minimum": 0 },
        "duration_ms": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    }
  }
}
