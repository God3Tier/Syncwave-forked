# Settings this service reads, with local example values. Running in Compose,
# the values come from compose.yaml; this file documents them for running the
# service directly on your machine (e.g. from the IDE) against the Compose
# infrastructure, which publishes its ports on localhost.
SERVICE_NAME=template
PORT=8080
AMQP_HOST=localhost
AMQP_PORT=5672
AMQP_USER=syncwave
AMQP_PASSWORD=syncwave
DB_HOST=localhost
DB_PORT=5432
DB_NAME=template
DB_USER=template
DB_PASSWORD=template
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=syncwave
AWS_SECRET_ACCESS_KEY=syncwave-secret
AWS_REGION=us-east-1
S3_BUCKET=syncwave-audio
